# Slack app -> Basic Information -> Signing Secret
SLACK_SIGNING_SECRET=

# GitHub PAT with `repo` scope (classic), or a fine-grained token with
# Pull requests: Read on the repos you care about.
GITHUB_TOKEN=

# The GitHub login whose open PRs the command reports.
GITHUB_LOGIN=

# Optional. Narrows the search, e.g. `repo:acme/backend` or `org:acme`.
# Empty means every repo the token can see.
GITHUB_SEARCH_SCOPE=

# Optional but recommended. Comma-separated Slack user IDs allowed to run the
# command. Empty means anyone in the workspace can run it.
SLACK_USER_IDS=
