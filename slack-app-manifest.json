{
  "display_information": {
    "name": "My PRs",
    "description": "Lists your open pull requests and approves the ones a message links, without leaving Slack.",
    "background_color": "#1f2328"
  },
  "features": {
    "bot_user": {
      "display_name": "My PRs",
      "always_online": false
    },
    "slash_commands": [
      {
        "command": "/myprs",
        "url": "https://slack-my-prs.vercel.app/api/slack",
        "description": "List your open pull requests",
        "should_escape": false
      }
    ],
    "shortcuts": [
      {
        "name": "Approve PRs",
        "type": "message",
        "callback_id": "approve_prs",
        "description": "Approve every pull request linked in this message"
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": ["commands"],
      "user": ["reactions:write"]
    }
  },
  "settings": {
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false,
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://slack-my-prs.vercel.app/api/interactivity"
    }
  }
}
